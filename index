            color: var(--muted);
            margin-bottom: 25px;
        }

        /* Toast */

        .toast {
            position: fixed;
            left: 50%;
            bottom: 30px;
            transform: translate(-50%, 100px);
            padding: 13px 20px;
            background: #18151c;
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 100px;
            font-size: 13px;
            opacity: 0;
            transition: .4s;
            z-index: 999;
        }

        .toast.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

        footer {
            text-align: center;
            padding: 35px;
            color: #666;
            font-size: 12px;
            border-top: 1px solid rgba(255,255,255,.05);
        }

        footer span {
            color: var(--pink);
        }

        /* Animações */

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes gradient {
            0% { background-position: 0%; }
            100% { background-position: 250%; }
        }

        @keyframes heartBeat {
            0% { transform: scale(.8); }
            50% { transform: scale(1.25); }
            100% { transform: scale(1); }
        }

        /* Responsivo */

        @media (max-width: 700px) {

            nav {
                display: none;
            }

            .profile-card {
                grid-template-columns: 1fr;
                text-align: center;
